# Copy to .env and fill in your values. .env is git-ignored.
LEAGUE=runes
DUCKDB_PATH=./data/prices.duckdb
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
# Multiple webhooks: comma-separated, each receives the same analysis PNG.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../A,https://discord.com/api/webhooks/.../B
